# ----------------------------------------------------------------------------
# Base de données PostgreSQL
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/dx?schema=public"

# ----------------------------------------------------------------------------
# Auth / session
# ----------------------------------------------------------------------------
# Secret utilisé pour signer les cookies de session (JWT). Générer une valeur
# aléatoire longue : `openssl rand -base64 48`
SESSION_SECRET="change-me-please-a-long-random-string"

# Attribut Secure du cookie de session. Par défaut : actif si NODE_ENV=production.
# ⚠️ TEMPORAIRE : mettre "false" pour pouvoir se connecter en HTTP (un cookie
# Secure est refusé par le navigateur sur une origine HTTP). À RETIRER dès que
# le HTTPS est en place.
# COOKIE_SECURE="false"

# Compte initial créé par le seed (voir prisma/seed.ts).
SEED_ORG_NAME="DTS Conception"
SEED_USER_EMAIL="teddy@example.com"
SEED_USER_PASSWORD="change-me"

# ----------------------------------------------------------------------------
# Stockage média — DISQUE LOCAL
# Les fichiers sont écrits dans ce dossier et servis par l'app (/api/media).
# En prod : pointer vers un volume Docker persistant (ex. /data/dx-uploads).
# En dev : laisser vide → dossier `.uploads` à la racine du projet.
# ----------------------------------------------------------------------------
# UPLOAD_DIR="/data/dx-uploads"

# Taille max d'un média uploadé, en octets (défaut 50 Mo).
MAX_UPLOAD_BYTES="52428800"
