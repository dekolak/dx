// Schéma Prisma — App de référencement technique
//
// Principe : tout est scopé par `organizationId` dès le départ (mono-org
// aujourd'hui, multi-org SaaS demain sans refonte). Le cœur du modèle est le
// bloc « Entry », réutilisé pour les points, le software et le journal.

generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev local ; la cible Debian couvre l'image Docker de prod.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant / identité
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users         User[]
  installations Installation[]
  entries       Entry[]
}

// Auth simple aujourd'hui (un seul utilisateur), mais le modèle accueille déjà
// plusieurs comptes rattachés à une organisation.
model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  name           String?
  passwordHash   String
  role           String   @default("owner") // owner | member (extensible)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Domaine : Installation > Pièce > Point > Entry  (+ Software par installation)
// NB : le modèle « Installation » est mappé sur la table historique « Machine »
// (@@map), et les FK gardent le nom de colonne « machineId » (@map) → renommage
// purement applicatif, aucune migration de données.
// ---------------------------------------------------------------------------

model Installation {
  id             String    @id @default(cuid())
  organizationId String
  name           String // ex: "DXonJet", "Weco Voyager", "Atelier découpe"
  category       String? // libre
  brand          String? // marque
  model          String? // modèle
  machineRef     String? // référence machine
  clientRef      String? // référence client
  active         Boolean   @default(true) // utilisée au quotidien (vue principale)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pieces         Piece[]
  softwareItems  SoftwareItem[]
  photosEnsemble PhotoEnsemble[]
  journalEntries Entry[]         @relation("InstallationJournal") // notes de journal liées

  @@index([organizationId])
  @@index([deletedAt])
  @@index([active])
  @@map("Machine")
}

model Piece {
  id             String    @id @default(cuid())
  installationId String    @map("machineId")
  name           String
  category       String? // libre, texte simple (~10 pièces max)
  photoUrl       String? // photo principale annotée
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  points         Point[]      @relation("PiecePoints") // points sur la photo de la pièce
  // Points d'une photo d'ensemble qui pointent (raccourci) vers cette pièce.
  shortcutPoints Point[]      @relation("PieceShortcuts")
  // Entrées de journal libres explicitement rattachées à cette pièce.
  linkedEntries  Entry[]      @relation("PieceLinkedEntries")

  @@index([installationId])
  @@index([deletedAt])
}

// Photo d'ensemble d'une installation (vue globale / plan d'atelier). Une
// installation peut en avoir plusieurs. Les points dessus sont soit un raccourci
// vers une Pièce, soit une info libre (avec ses propres entrées).
model PhotoEnsemble {
  id             String    @id @default(cuid())
  installationId String
  url            String // fichier disque, pleine résolution (comme la photo de pièce)
  label          String? // ex : "Vue avant", "Plan atelier"
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  points       Point[]

  @@index([installationId])
  @@index([deletedAt])
}

model Point {
  id              String    @id @default(cuid())
  // Parent : EXACTEMENT un des deux (imposé côté appli).
  pieceId         String? // point sur la photo d'une Pièce
  photoEnsembleId String? // point sur une photo d'ensemble
  // Si défini : ce point (d'ensemble) est un RACCOURCI vers cette Pièce.
  targetPieceId   String?
  x               Float? // position sur la photo, null si "point libre"/virtuel
  y               Float?
  num             Int
  icon            String? // emoji facultatif (repère visuel : ⚠️ ⚡ 🔌 …), affiché sur la pastille dans l'app
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  piece         Piece?         @relation("PiecePoints", fields: [pieceId], references: [id], onDelete: Cascade)
  photoEnsemble PhotoEnsemble? @relation(fields: [photoEnsembleId], references: [id], onDelete: Cascade)
  targetPiece   Piece?         @relation("PieceShortcuts", fields: [targetPieceId], references: [id], onDelete: SetNull)
  entries       Entry[] // historique empilé (points info libre)
  // Liaisons vers d'autres repères (connexion physique carte↔carte). Stockées
  // dans un ordre canonique (aPointId < bPointId) → chaque liaison = 1 ligne,
  // vue des deux côtés (linksA quand ce point est « a », linksB quand il est « b »).
  linksA        PointLink[]    @relation("PointLinkA")
  linksB        PointLink[]    @relation("PointLinkB")

  @@index([pieceId])
  @@index([photoEnsembleId])
  @@index([targetPieceId])
  @@index([deletedAt])
}

// Liaison entre DEUX repères (ex. un connecteur relié par une nappe à un
// connecteur d'une autre carte). Non orientée : (a,b) stockés triés, unique.
model PointLink {
  id             String   @id @default(cuid())
  organizationId String // dénormalisé pour le scope (pas de relation nécessaire)
  aPointId       String
  bPointId       String
  label          String? // ex : "nappe 20 broches", "24V"
  createdAt      DateTime @default(now())

  aPoint Point @relation("PointLinkA", fields: [aPointId], references: [id], onDelete: Cascade)
  bPoint Point @relation("PointLinkB", fields: [bPointId], references: [id], onDelete: Cascade)

  @@unique([aPointId, bPointId])
  @@index([aPointId])
  @@index([bPointId])
  @@index([organizationId])
}

model SoftwareItem {
  id             String    @id @default(cuid())
  installationId String    @map("machineId")
  name           String // ex: nom / version logiciel
  description    String? // notice / infos générales (texte long)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  installation   Installation      @relation(fields: [installationId], references: [id], onDelete: Cascade)
  entries        Entry[] // changelog / notes empilées
  versions       SoftwareVersion[] // fichiers de versions (historique conservé)
  journalEntries Entry[]           @relation("SoftwareJournal") // notes de journal liées

  @@index([installationId])
  @@index([deletedAt])
}

// Une version téléversée d'un logiciel : le fichier (firmware, .bin/.hex/.zip…),
// sa référence, sa date. On garde l'historique (rollback) ; suppression manuelle
// et définitive (le fichier disque est retiré avec).
model SoftwareVersion {
  id             String   @id @default(cuid())
  softwareItemId String
  version        String // référence saisie (ex : "v1.2.3", "2024-06 build 12")
  fileUrl        String // /api/media/... (fichier sur disque)
  fileName       String // nom d'origine du fichier
  fileSize       Int? // octets
  note           String? // ex : "corrige bug capteur"
  isCurrent      Boolean  @default(false) // version actuellement en service
  createdAt      DateTime @default(now()) // = date d'upload

  softwareItem SoftwareItem @relation(fields: [softwareItemId], references: [id], onDelete: Cascade)

  @@index([softwareItemId])
}

// ---------------------------------------------------------------------------
// Le bloc central réutilisé partout
// ---------------------------------------------------------------------------

model Entry {
  id             String    @id @default(cuid())
  organizationId String
  type           String // 'point' | 'software' | 'journal'
  text           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  shareable      Boolean   @default(false)
  shareToken     String?   @unique

  // Rattachement (au plus un des trois selon `type`).
  pointId        String?
  softwareItemId String?
  // Lien d'une note de journal (au plus UN des trois, optionnel) : pièce,
  // installation, ou logiciel.
  linkedPieceId        String?
  linkedInstallationId String?
  linkedSoftwareItemId String?

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  point             Point?        @relation(fields: [pointId], references: [id], onDelete: Cascade)
  softwareItem      SoftwareItem? @relation(fields: [softwareItemId], references: [id], onDelete: Cascade)
  linkedPiece       Piece?        @relation("PieceLinkedEntries", fields: [linkedPieceId], references: [id], onDelete: SetNull)
  linkedInstallation Installation? @relation("InstallationJournal", fields: [linkedInstallationId], references: [id], onDelete: SetNull)
  linkedSoftware    SoftwareItem? @relation("SoftwareJournal", fields: [linkedSoftwareItemId], references: [id], onDelete: SetNull)
  media             Media[]

  @@index([organizationId])
  @@index([type])
  @@index([pointId])
  @@index([softwareItemId])
  @@index([linkedPieceId])
  @@index([linkedInstallationId])
  @@index([linkedSoftwareItemId])
  @@index([deletedAt])
  @@index([createdAt])
}

model Media {
  id        String    @id @default(cuid())
  entryId   String
  url       String // objet OVH Object Storage
  type      String // 'photo' | 'video'
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([deletedAt])
}
