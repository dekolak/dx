// Schéma Prisma — App de référencement technique
//
// Principe : tout est scopé par `organizationId` dès le départ (mono-org
// aujourd'hui, multi-org SaaS demain sans refonte). Le cœur du modèle est le
// bloc « Entry », réutilisé pour les points, le software et le journal.

generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev local ; la cible Debian couvre l'image Docker de prod.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant / identité
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users         User[]
  installations Installation[]
  entries       Entry[]
}

// Auth simple aujourd'hui (un seul utilisateur), mais le modèle accueille déjà
// plusieurs comptes rattachés à une organisation.
model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  name           String?
  passwordHash   String
  role           String   @default("owner") // owner | member (extensible)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Domaine : Installation > Pièce > Point > Entry  (+ Software par installation)
// NB : le modèle « Installation » est mappé sur la table historique « Machine »
// (@@map), et les FK gardent le nom de colonne « machineId » (@map) → renommage
// purement applicatif, aucune migration de données.
// ---------------------------------------------------------------------------

model Installation {
  id             String    @id @default(cuid())
  organizationId String
  name           String // ex: "DXonJet", "Weco Voyager", "Atelier découpe"
  category       String? // libre
  brand          String? // marque
  model          String? // modèle
  machineRef     String? // référence machine
  clientRef      String? // référence client
  active         Boolean   @default(true) // utilisée au quotidien (vue principale)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pieces        Piece[]
  softwareItems SoftwareItem[]

  @@index([organizationId])
  @@index([deletedAt])
  @@index([active])
  @@map("Machine")
}

model Piece {
  id             String    @id @default(cuid())
  installationId String    @map("machineId")
  name           String
  category       String? // libre, texte simple (~10 pièces max)
  photoUrl       String? // photo principale annotée
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  installation  Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  points        Point[]
  // Entrées de journal libres explicitement rattachées à cette pièce.
  linkedEntries Entry[] @relation("PieceLinkedEntries")

  @@index([installationId])
  @@index([deletedAt])
}

model Point {
  id        String    @id @default(cuid())
  pieceId   String
  x         Float? // position sur la photo, null si "point libre"/virtuel
  y         Float?
  num       Int
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  piece   Piece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  entries Entry[] // historique empilé

  @@index([pieceId])
  @@index([deletedAt])
}

model SoftwareItem {
  id             String    @id @default(cuid())
  installationId String    @map("machineId")
  name           String // ex: nom / version logiciel
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  entries      Entry[] // changelog empilé

  @@index([installationId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Le bloc central réutilisé partout
// ---------------------------------------------------------------------------

model Entry {
  id             String    @id @default(cuid())
  organizationId String
  type           String // 'point' | 'software' | 'journal'
  text           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  shareable      Boolean   @default(false)
  shareToken     String?   @unique

  // Rattachement (au plus un des trois selon `type`).
  pointId        String?
  softwareItemId String?
  linkedPieceId  String? // journal libre lié à une pièce (optionnel)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  point        Point?        @relation(fields: [pointId], references: [id], onDelete: Cascade)
  softwareItem SoftwareItem? @relation(fields: [softwareItemId], references: [id], onDelete: Cascade)
  linkedPiece  Piece?        @relation("PieceLinkedEntries", fields: [linkedPieceId], references: [id], onDelete: SetNull)
  media        Media[]

  @@index([organizationId])
  @@index([type])
  @@index([pointId])
  @@index([softwareItemId])
  @@index([linkedPieceId])
  @@index([deletedAt])
  @@index([createdAt])
}

model Media {
  id        String    @id @default(cuid())
  entryId   String
  url       String // objet OVH Object Storage
  type      String // 'photo' | 'video'
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([deletedAt])
}
